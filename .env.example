# Copy to .env and fill in. Only EXPO_PUBLIC_* values are bundled into the app.
# The Supabase anon key is public by design (data is protected by Row Level Security).
# NEVER put server secrets here (Supabase service-role key, Google client secret, Gemini API key).
# Those live only in the Supabase dashboard / Edge Function secrets.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_HELPLINE_NUMBER=
