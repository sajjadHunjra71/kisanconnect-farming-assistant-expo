# Copy to .env and fill in. Only EXPO_PUBLIC_* values are bundled into the app.
# NEVER put server secrets here (Supabase service-role key, Gemini API key).
# Those go in Supabase Edge Function secrets: `supabase secrets set GEMINI_API_KEY=...`
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_HELPLINE_NUMBER=
