{
  "expo": {
    "name": "KisanConnect",
    "slug": "kisanconnect",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kisanconnect",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.sajjadhunjra.kisanconnect",
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1F5C3F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sajjadhunjra.kisanconnect"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3C44A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 112,
          "dark": {
            "backgroundColor": "#F3C44A"
          }
        }
      ],
      "expo-font",
      "expo-localization",
      "expo-secure-store",
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      "expo-sharing",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "KisanConnect uses your location to set your farm on the map and show local weather and advice."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1F5C3F"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
